FROM docker.io/library/ubuntu@sha256:9a04f13b3f80ef056361e30868593b1cfd2279fe19e4081cb93a90bf56819d6a
# Official noble-20261110.1 amd64, fetched public OCI manifest in provenance.json.
# Frozen Ubuntu archive date, signed apt metadata. All fetch/build before probe.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod 755 /usr/sbin/policy-rc.d \
 && apt-get update --snapshot 20261125T000000Z \
 && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y --snapshot 20261125T000000Z systemd systemd-sysv dbus iproute2 python3 util-linux \
 && dpkg-query -W > /image-packages.txt \
 && systemd --version > /image-systemd-version.txt \
 && python3 -c 'import pathlib,re; v=pathlib.Path("/image-systemd-version.txt").read_text().splitlines()[0]; assert re.fullmatch(r"systemd 255(?:\.[0-9]+)*(?: \([^\r\n]+\))?",v),v' \
 && rm -rf /var/lib/apt/lists/* /usr/sbin/policy-rc.d \
 && mkdir -p /etc/hexmon /var/lib/hexmon-edge /home/probe-visible \
 && chmod 777 /etc/hexmon /var/lib/hexmon-edge \
 && printf 'visible only outside protected service\n' > /home/probe-visible/sentinel \
 && groupadd --gid 55000 hexprobe && useradd --uid 55000 --gid 55000 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hexprobe
COPY inside.py /probe/inside.py
COPY production-unit.reference /probe/production-unit.reference
ENV container=podman
CMD ["/sbin/init"]
