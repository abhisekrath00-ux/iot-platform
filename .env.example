# Copy to .env and adjust. Never commit real secrets.
POSTGRES_USER=iot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iot
DATABASE_URL=postgres://iot:change-me@postgres:5432/iot?sslmode=disable

MQTT_HOST=mosquitto
MQTT_PORT=8883
# Lab uses 1883 (no TLS). Production: 8883 with mTLS, see deploy/mosquitto.
MQTT_TLS=false

API_PORT=8000
WEB_PORT=8080

# Notifications (optional; leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
SLACK_BOT_TOKEN=

# Auth
JWT_SIGNING_SECRET=change-me-32-bytes-minimum
# Optional: enables the encrypted secrets store. 32 random bytes, base64 (openssl rand -base64 32). Losing it makes stored secrets unreadable.
SECRETS_KEY=
# Optional: database pool size per API replica (default max(20, 4 x CPUs)). Background leader jobs pin connections, so values below 20 are raised to 20.
DB_MAX_CONNS=

# Reverse proxy network (CIDR) whose X-Forwarded-For is trusted for per-client rate limits. Empty = never trust the header.
TRUSTED_PROXIES=

# OAuth state: empty preserves legacy default (Redis when REDIS_URL is set, else memory).
# Set postgres on every API replica to share short-lived single-use login/connect state
# through the existing database. Switching backends invalidates in-flight OAuth redirects.
OAUTH_STATE_BACKEND=

# Optional shared Redis/Valkey endpoint. Use the SAME endpoint and database on all
# API replicas. This does not discover Sentinel primaries or Cluster redirects.
# redis:// is plaintext; rediss:// verifies the server certificate and hostname.
# URL-encode ACL username/password. /database defaults to 0; query options refused.
REDIS_URL=
REDIS_TLS_CA_FILE=
REDIS_TLS_CERT_FILE=
REDIS_TLS_KEY_FILE=
# redis opts into shared response caching; shared read errors bypass caching and read the backend.
CACHE_BACKEND=
